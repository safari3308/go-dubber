{
  "nas_dir": "<your_nas_path>",
  "api_url": "http://localhost:8000",
  "api_token": "<your_api_token>",
  "use_gpu": true,
  "workers": 2,
  "force_reprocess": false,
  "only_check_kokoro": false,
  "tts_speed": 1.2,
  "ffmpeg": {
    "gpu_codec": "hevc_nvenc",
    "gpu_preset": "p2",
    "gpu_cq": 24,
    "gpu_pix_fmt": "yuv420p",
    "cpu_preset": "medium",
    "cpu_crf": 23,
    "audio_bitrate": "192k",
    "audio_sample_rate": "48000",
    "audio_channels": "2",
    "volume_boost": "2.0"
  }
}