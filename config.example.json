{
  "nas_dir": "<your_nas_path>",
  "api_url": "http://localhost:8000",
  "api_token": "<your_api_token>",
  "use_gpu": true,
  "workers": 2,
  "force_reprocess": false,
  "skip_encode": false,
  "skip_sub_sync": false,
  "ai_track_as_first_track": false,
  "drop_song_subtitles": true,
  "dub_languages": ["en", "vi"],
  "tts_speed": 1.1,
  "ffmpeg": {
    "gpu_codec": "hevc_nvenc",
    "gpu_preset": "p6",
    "gpu_cq": 21,
    "gpu_pix_fmt": "p010le",
    "cpu_preset": "medium",
    "cpu_crf": 20,
    "audio_bitrate": "192k",
    "audio_sample_rate": "48000",
    "audio_channels": "2",
    "volume_boost": "2.0"
  }
}